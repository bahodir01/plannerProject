# Почти все настройки теперь задаются в АДМИН-ПАНЕЛИ (через браузер),
# а не здесь. В .env остаются только параметры первого запуска панели.

# --- Первичный вход в админ-панель (создаётся при первом старте) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Порт админ-панели
ADMIN_PORT=8000

# --- Секрет подписи сессий (необязательно; иначе сгенерируется в data/) ---
# ADMIN_SESSION_SECRET=длинная-случайная-строка

# --- Каталоги (по умолчанию data/ и logs/) ---
# DATA_DIR=data
# LOG_DIR=logs
