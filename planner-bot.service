[Unit]
Description=Planner Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/planner-bot
EnvironmentFile=/home/YOUR_USER/planner-bot/.env
ExecStart=/home/YOUR_USER/planner-bot/venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
