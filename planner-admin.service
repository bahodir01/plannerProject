[Unit]
Description=Planner Bot Admin Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/planner-bot
EnvironmentFile=/home/YOUR_USER/planner-bot/.env
ExecStart=/home/YOUR_USER/planner-bot/venv/bin/python -m uvicorn admin.app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
